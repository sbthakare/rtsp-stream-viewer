# Base URL of the Go backend. Leave empty in local dev (Vite proxies /api and /ws).
# In production set it to your deployed backend, e.g. https://rtsp-viewer-api.onrender.com
VITE_API_URL=

# Optional: comma-separated RTSP URLs shown as one-click "test stream" chips.
# These must be reachable from the BACKEND, not from your browser.
VITE_DEMO_STREAMS=rtsp://localhost:8554/cam1,rtsp://localhost:8554/cam2,rtsp://localhost:8554/cam3
