PORT=8080
FFMPEG_PATH=ffmpeg
# Comma-separated browser origins allowed to open WebSockets / call the API. Use your frontend URL in production.
ALLOWED_ORIGINS=*
# Hard cap on simultaneous FFmpeg processes (each one costs CPU).
MAX_STREAMS=8
# Output video settings: wider/faster = more CPU and bandwidth. FPS must be 24, 25, 30, 50, or 60 for MPEG-1.
VIDEO_BITRATE=1500k
MAX_WIDTH=960
FPS=25
# Optional: comma-separated list of RTSP hosts users may connect to (empty = any host).
ALLOWED_RTSP_HOSTS=
# Set true on a public deployment to refuse loopback/private/link-local targets (SSRF protection).
BLOCK_PRIVATE_HOSTS=false
